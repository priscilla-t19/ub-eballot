# UB eBallot Environment Configuration Template
# Copy this to .env and fill in your actual values
# DO NOT commit .env to version control!

# ════════════════════════════════════════════════════════════════
# FLASK & CORE CONFIG
# ════════════════════════════════════════════════════════════════
DEBUG=False
TESTING=False

# Change this to a random string (at least 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-random-secret-key-here-change-this-in-production

# Database connection string
# SQLite (development): sqlite:///ub_eballot.db
# PostgreSQL: postgresql://user:password@localhost:5432/ub_eballot
# MySQL: mysql+pymysql://user:password@localhost:3306/ub_eballot
DATABASE_URL=sqlite:///ub_eballot.db

PREFERRED_URL_SCHEME=https

# ════════════════════════════════════════════════════════════════
# CRYPTOGRAPHY (CRITICAL!)
# ════════════════════════════════════════════════════════════════
# Ballot encryption key (Fernet 32-byte base64 encoded)
# Generate with: 
#   from cryptography.fernet import Fernet
#   print(Fernet.generate_key().decode())
# NEVER CHANGE THIS AFTER VOTING BEGINS!
BALLOT_ENCRYPTION_KEY=your-base64-encoded-fernet-key-here

# Voter pepper for anonymous duplicate-vote prevention
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER CHANGE THIS AFTER VOTING BEGINS!
VOTER_PEPPER=your-random-pepper-string-never-change-after-voting

# ════════════════════════════════════════════════════════════════
# SESSION & SECURITY
# ════════════════════════════════════════════════════════════════
# Set to True in production (HTTPS only)
SESSION_COOKIE_SECURE=False

# ════════════════════════════════════════════════════════════════
# OTP (One-Time Password) CONFIGURATION
# ════════════════════════════════════════════════════════════════
# OTP expiry in seconds (default: 600 = 10 minutes)
OTP_EXPIRY=600

# ════════════════════════════════════════════════════════════════
# RATE LIMITING
# ════════════════════════════════════════════════════════════════
# Maximum OTP verification attempts before lockout
RATELIMIT_OTP_ATTEMPTS=5

# Time window for OTP attempts in seconds (300 = 5 minutes)
RATELIMIT_OTP_WINDOW=300

# Maximum login attempts before lockout
RATELIMIT_LOGIN_ATTEMPTS=10

# Time window for login attempts in seconds (900 = 15 minutes)
RATELIMIT_LOGIN_WINDOW=900

# ════════════════════════════════════════════════════════════════
# EMAIL CONFIGURATION
# ════════════════════════════════════════════════════════════════

# Gmail Setup:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate an app-specific password
# 3. Use that password below (NOT your regular Gmail password)

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password

# Alternative: Use your own mail server
# MAIL_SERVER=mail.yourdomain.com
# MAIL_PORT=587
# MAIL_USERNAME=admin@yourdomain.com
# MAIL_PASSWORD=your-password

# ════════════════════════════════════════════════════════════════
# ADMIN CREDENTIALS (Change immediately after first login!)
# ════════════════════════════════════════════════════════════════
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# ════════════════════════════════════════════════════════════════
# LOGGING
# ════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO
LOG_FILE=logs/ub_eballot.log

# ════════════════════════════════════════════════════════════════
# NOTES FOR PRODUCTION DEPLOYMENT
# ════════════════════════════════════════════════════════════════
#
# SECURITY CHECKLIST:
# ✅ Generate new SECRET_KEY
# ✅ Generate new BALLOT_ENCRYPTION_KEY
# ✅ Generate new VOTER_PEPPER (NEVER CHANGE AFTER VOTING!)
# ✅ Change ADMIN_USERNAME and ADMIN_PASSWORD
# ✅ Set DATABASE_URL to production database (PostgreSQL recommended)
# ✅ Enable SESSION_COOKIE_SECURE=True (HTTPS only)
# ✅ Set DEBUG=False
# ✅ Configure MAIL_SERVER and MAIL_PASSWORD
# ✅ Set PREFERRED_URL_SCHEME=https
# ✅ Use strong database password
# ✅ Set up database backups
# ✅ Enable HTTPS/SSL certificates
# ✅ Run security penetration test
# ✅ Review deployment checklist: flask security-checklist
#
# KEY REMINDERS:
# • NEVER change BALLOT_ENCRYPTION_KEY after voting begins
# • NEVER change VOTER_PEPPER after voting begins
# • NEVER commit .env to version control
# • Use environment variables in production, not .env files
# • Rotate admin credentials regularly
# • Monitor audit logs for suspicious activity
# • Keep database backups in secure location
# • Test database recovery procedures
#
