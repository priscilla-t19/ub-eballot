# UB eBallot — Environment Configuration
# NEVER commit this file to version control.
# Keep a backup of SECRET_KEY and VOTER_PEPPER in a secure location.

# ── Flask environment ──────────────────────────────────────────────────────
# Set to 'development' while testing locally; 'production' before going live.
FLASK_ENV=development
DEBUG=False

# ── Security keys ──────────────────────────────────────────────────────────
# IMPORTANT: generate fresh values before production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(48))"
# Once voting starts, VOTER_PEPPER must NEVER change — it would invalidate
# all existing voter tokens (people who already voted could vote again).
SECRET_KEY=b159a2b30a51230e214808f3ba513a41919ddd76208e2e493014d46651594a145eea6ad43ff61ae1e8decbfcc1bb9c10
VOTER_PEPPER=017e3166febb5ab3a6d30441053bd995b9087131962e630ef92f6866c7c6e0a8f139bceb346c6202755744de523a3258

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///ub_eballot.db

# ── Session / cookie settings ──────────────────────────────────────────────
# Keep False + http while running locally over plain HTTP.
# Switch both to True / https before deploying to a real server.
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
PREFERRED_URL_SCHEME=http

# ── Admin credentials ──────────────────────────────────────────────────────
# ADMIN_PASSWORD is the single source of truth for the admin password.
# Change the password below, then restart — the app will sync it automatically.
# Must be ≥12 chars with uppercase, lowercase, digit, and special character.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=k-ZgktKcBj0rRb1txxoX6Ssw
BALLOT_ENCRYPTION_KEY=FbJTzIfeQggvGfSf1wavem04cfjtFrMP0ixw-LF03Rc=

# ── Gmail SMTP ─────────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply.ubeballot@gmail.com
MAIL_PASSWORD=vjwd jclo hmqq uglc

# Optional: override OTP expiry (seconds). Default is 600 (10 minutes).
# OTP_EXPIRY=600
